# Copie este arquivo para .env e ajuste os valores.
# .env NUNCA deve ser commitado.

# Django
DJANGO_SECRET_KEY=troque-isto-por-uma-chave-aleatoria-de-50-caracteres
DJANGO_DEBUG=True
# Liste TODOS os hosts/IPs pelos quais o backend será acessado.
# Em dev você normalmente quer: localhost (mac), 127.0.0.1 (curl),
# o IP da rede local pra testar em iPhone físico (ex.: 192.168.x.x ou 100.x.x.x do Tailscale).
# Em dev, pra simplificar, pode usar * (NÃO USE em produção).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (compartilhado entre o serviço `db` e o `web`)
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS — origens permitidas
# Mobile (iOS/Android) usa scheme custom e dispensa CORS.
# - localhost:5173 / 127.0.0.1:5173 — Vite dev server do frontend-coach (SPA do personal)
# - https://coach.fichagym.com — domínio de produção do SPA do personal
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://coach.fichagym.com

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=14

# Billing / Asaas (assinatura do personal + split dos alunos)
# Deixe vazio em "modo scaffold": o cadastro grátis de personal e o limite de
# 1 aluno funcionam sem Asaas. Preencha com a chave de SANDBOX pra habilitar
# a cobrança (mensal/anual) e o split.
#
# Conta sandbox: criar em https://sandbox.asaas.com (sem CNPJ real).
# API key: em Integrações no painel sandbox.
ASAAS_API_KEY=
ASAAS_API_BASE=https://sandbox.asaas.com/api/v3
# Shared secret enviado pelo Asaas no header `asaas-access-token` (você define
# quando cadastra a URL do webhook no painel).
ASAAS_WEBHOOK_TOKEN=

# Valor da assinatura do personal (em CENTAVOS, NUNCA confiar no front).
ASAAS_PRICE_MONTHLY_CENTS=4000
ASAAS_PRICE_ANNUAL_CENTS=30000

# Limite de alunos no plano grátis (sem assinatura paga):
FREE_STUDENT_LIMIT=1

# Split (personal cobra os alunos; FichaGym fica com %):
# % por transação. Sai ANTES do rateio (não recai 100% na plataforma).
PLATFORM_FEE_PERCENT=5.0
# Wallet ID da plataforma — opcional; só pra cenários onde queremos explicitar
# o destino da fee em vez de deixar implícito na conta master.
PLATFORM_WALLET_ID=
