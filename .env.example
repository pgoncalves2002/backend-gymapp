# Copie este arquivo para .env e ajuste os valores.
# .env NUNCA deve ser commitado.

# Django
DJANGO_SECRET_KEY=troque-isto-por-uma-chave-aleatoria-de-50-caracteres
DJANGO_DEBUG=True
# Liste TODOS os hosts/IPs pelos quais o backend será acessado.
# Em dev você normalmente quer: localhost (mac), 127.0.0.1 (curl),
# o IP da rede local pra testar em iPhone físico (ex.: 192.168.x.x ou 100.x.x.x do Tailscale).
# Em dev, pra simplificar, pode usar * (NÃO USE em produção).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (compartilhado entre o serviço `db` e o `web`)
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS — origens permitidas
# Mobile (iOS/Android) usa scheme custom e dispensa CORS.
# - localhost:5173 / 127.0.0.1:5173 — Vite dev server do frontend-coach (SPA do personal)
# - https://coach.fichagym.com — domínio de produção do SPA do personal
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://coach.fichagym.com

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=14
