# Produção — copie pra .env.prod na VPS e ajuste os valores.
# NUNCA commite o .env.prod (já está no .gitignore).

# ---------------------------------------------------------------------------
# Domínio + segurança
# ---------------------------------------------------------------------------
# Domínio principal da API (ex.: api.gym.com.br). Usado pelo nginx + certbot.
DJANGO_DOMAIN=api.seudominio.com.br

# Subdomínio do SPA do personal trainer (build estático do frontend-coach).
# O nginx serve o build em /srv/coach (volume `coach_dist`). Se você não vai
# usar o SPA agora, deixe vazio (o template ainda renderiza, mas o subdomínio
# só responde quando você apontar DNS + emitir cert via init-coach.sh).
COACH_DOMAIN=coach.seudominio.com.br

# E-mail pro Let's Encrypt te avisar de expiração de certificado.
LETSENCRYPT_EMAIL=voce@seudominio.com.br

# Gere com:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=COLOQUE_UMA_CHAVE_REAL_AQUI

DJANGO_DEBUG=False
# Inclua o domínio da API + qualquer outro host que vai bater nele.
DJANGO_ALLOWED_HOSTS=api.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.seudominio.com.br

# ---------------------------------------------------------------------------
# Postgres — escolha senhas fortes e ÚNICAS desta instalação
# ---------------------------------------------------------------------------
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_E_UNICA_AQUI
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# CORS — domínios autorizados a chamar a API via browser.
# O app iOS/Android via URLSession/OkHttp NÃO precisa de CORS; só Web.
# Inclua aqui o subdomínio do frontend-coach se for usar (HTTPS!).
# ---------------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=https://coach.seudominio.com.br

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=14
